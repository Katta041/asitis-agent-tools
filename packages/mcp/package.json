{
  "name": "@asitis/mcp",
  "version": "0.3.0",
  "mcpName": "io.github.Katta041/asitis-mcp",
  "description": "Lint CLAUDE.md, AGENTS.md, SKILL.md and Cursor rules: hidden prompt-injection comments, token budget, outline. Read-only MCP server, no network.",
  "type": "module",
  "bin": {
    "asitis-mcp": "dist/asitis-mcp.mjs",
    "asitis": "dist/asitis.mjs"
  },
  "files": [
    "dist/asitis-mcp.mjs",
    "dist/asitis.mjs",
    "dist/THIRD_PARTY_NOTICES.md",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "keywords": [
    "claude-code",
    "claude-code-plugin",
    "claude-md",
    "agents-md",
    "skill-md",
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "linter",
    "lint",
    "markdown",
    "prompt-injection",
    "cursor-rules",
    "copilot-instructions",
    "gemini-md",
    "steering-files",
    "ai-agents",
    "context-window",
    "token-count",
    "invisible-unicode"
  ],
  "homepage": "https://asitis.app/claude-code",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Katta041/asitis-agent-tools.git",
    "directory": "packages/mcp"
  },
  "bugs": "https://github.com/Katta041/asitis-agent-tools/issues",
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "sync-plugin": "node scripts/build.mjs --sync-plugin",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run typecheck && npm run build && vitest run",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "@types/node": "26.6.5",
    "ajv": "8.20.0",
    "esbuild": "0.28.2",
    "typescript": "7.0.2",
    "vitest": "5.0.4",
    "yaml": "2.9.1",
    "zod": "4.6.6"
  }
}
