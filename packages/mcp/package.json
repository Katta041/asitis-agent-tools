{
  "name": "@asitis/mcp",
  "version": "0.1.0",
  "description": "Read-only MCP server for markdown and AI agent steering files (CLAUDE.md, AGENTS.md, SKILL.md, rules, memory): byte-faithful read, outline, lint, context budget. No network, no writes.",
  "type": "module",
  "bin": {
    "asitis-mcp": "dist/asitis-mcp.mjs"
  },
  "files": [
    "dist/asitis-mcp.mjs",
    "dist/THIRD_PARTY_NOTICES.md",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "keywords": [
    "mcp",
    "markdown",
    "claude-code",
    "agents-md",
    "skill-md",
    "lint",
    "steering-files"
  ],
  "homepage": "https://asitis.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Katta041/asitis-agent-tools.git",
    "directory": "packages/mcp"
  },
  "bugs": "https://github.com/Katta041/asitis-agent-tools/issues",
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "sync-plugin": "node scripts/build.mjs --sync-plugin",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run typecheck && npm run build && vitest run",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "1.31.0",
    "@types/node": "26.6.3",
    "esbuild": "0.28.2",
    "typescript": "7.0.2",
    "vitest": "5.0.3",
    "yaml": "2.9.1",
    "zod": "4.6.5"
  }
}
